#import modules
import os
import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

#extraction nom de l'essai 
exp=os.getcwd().split(os.sep)[-1].split(".")[0] #Trouver le nom du fichier
exp

#prendre infos du fichier 
def get_info():
    with open(infos) as finp:
        lines=finp.readlines()
        for line in lines :
            items=line.split(':')
            key=items[0].split('(')[0]
            if key == "E":
                E=float(items[1])
            if key == "Rp02":
                Rp02=float(items[1])
            if key == "Rm":
                Rm=float(items[1])
            if key == "Au":
                Au=float(items[1])
            if key == "A":
                A=float(items[1])
            if key == "strain_rate":
                rate=float(items[1])
    return E, Rp02, Rm, Au, A, rate
    
global infos

#extraction des résultats de l'autre fichier (fichier résultats du code élastique précédent)
infos = exp +'.info'
E, Rp02, Rm, Au, A, rate = get_info()

print(E, Rp02, Rm, Au, A, rate)

csv = np.genfromtxt("Resultats_"+exp+".csv")

#Expression des contrainte et déformation vraies
#Contrainte inférieure à la contrainte maximale et supérieure à 70MPa (ou autre valeur en fonction du matériau)
sig = csv[:,4]

id_max = np.argmax(sig)
csv = csv[:id_max]
sig = csv[:,4]
csv=csv[sig>70]

#Données vraies
eps_t = csv[:,3]
sig_t = csv[:,5]

#Données nominales
eps=csv[:,1]
sig=csv[:,4]

#déformation plastique vraie 
p = eps_t - sig_t / E
plt.xlabel('Déformation plastique vraie')
plt.ylabel('Contrainte vraie')
plt.plot(p, sig_t)
plt.show()

# Loi de puissance $\sigma = K\epsilon^n$
def perform_regression(sig, p, p_f): #p_f = valeur minimale déformation
    sig = sig[p>0]
    p=p[p>0]

    #Passage en log
    log_sig = np.log(sig[p>p_f])
    log_p = np.log(p[p>p_f])
    #régression linéaire
    slope, intercept, r_value, p_value, std_err = stats.linregress(log_p, log_sig)

    n= slope
    K = np.exp(intercept)
    print(n, K, r_value**2)
    
    return K, n, r_value**2

#Calcul des coefficients pour cet essai 
K, n, r = perform_regression(sig_t, p, 0.018)

#Courbe contrainte vraie - déformation plastique 
fit_p = np.linspace(0, max(p), 100)
fit_sig = K*((fit_p)**n)
plt.xlabel('Déformation plastique')
plt.ylabel('Contrainte vraie')
plt.plot(fit_p, fit_sig, label = 'simulee')
plt.plot(p, sig_t, label = 'donnees')
plt.legend(loc='best')
plt.show()

# Loi de Jonhson-cook $\sigma = A + B\epsilon^nc$
#Test de plusieurs valeurs de A. En choisir une proche de la limite d'élasticité même si r n'est pas maximal.
for A in np.arange(0, 170, 10):
    print(A)
    B, nc, rc_squared = perform_regression (sig_t-A, p, 0.018)
    plt.plot(A, rc_squared, 'bo')

plt.grid()
plt.show()

#Vérification sur la valeur de A choisie 
A = 150
